# ===========================
# AI Cybercrime System - Environment Variables
# Copy this file to .env and fill in your values
# ===========================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://cybercrime_user:cybercrime_pass@localhost:5432/cybercrime_db
SYNC_DATABASE_URL=postgresql://cybercrime_user:cybercrime_pass@localhost:5432/cybercrime_db

# --- Google Gemini API ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- JWT Security ---
SECRET_KEY=change_this_to_a_long_random_secret_key_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- App Settings ---
APP_NAME=AI-Powered Cyber Crime Complaint & Assistance System
APP_VERSION=1.0.0
DEBUG=True
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- File Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# --- OCR ---
TESSERACT_CMD=tesseract
