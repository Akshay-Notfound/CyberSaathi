# =================================================================
# CyberSaathi - .gitignore
# =================================================================

# --- Python / backend ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
backend/venv/
backend/.env
backend/app/uploads/*
!backend/app/uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
backend/cybercrime.db
cybercrime.db
*.sqlite
*.sqlite3

# ML artifacts are regenerated by train_classifier.py; keep the dataset, drop
# the trained binaries to avoid committing large/duplicate files.
backend/app/ml/artifacts/*.joblib
backend/models/*.joblib
backend/models/*.pkl

# --- Node / frontend ---
frontend/node_modules/
frontend/dist/
frontend/.env
node_modules/
dist/

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
*.log
Thumbs.db
*.swp
*.swo
